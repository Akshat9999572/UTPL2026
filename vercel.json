{
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/seo-handler", "destination": "/api/seo-handler" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/seo-handler.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
